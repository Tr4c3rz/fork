            sidebar.Position = UDim2.fromOffset(0, 48)
            sidebar:FindFirstChildOfClass("UIPadding").PaddingLeft = UDim.new(0, mobileNavExpanded and 8 or 5)
            sidebar:FindFirstChildOfClass("UIPadding").PaddingRight = UDim.new(0, mobileNavExpanded and 8 or 5)
            content.Position = UDim2.new(0, sidebarWidth, 0, 48)
            content.Size = UDim2.new(1, -sidebarWidth, 1, -48)
            tabList.ScrollBarThickness = 2
            navToggle.Visible = true
            for _, tab in ipairs(window.Tabs) do
                tab.Button.Text = mobileNavExpanded and ((tab.Icon and (tab.Icon .. "  ") or "") .. tab.Name) or (tab.Icon or "•")
                tab.Button.TextXAlignment = mobileNavExpanded and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center
                tab.Button.TextSize = mobileNavExpanded and 11 or 19
            end
        else
            main.Size = options.Size or UDim2.fromOffset(650, 420)
            sidebar.Size = UDim2.new(0, 155, 1, -48)
            sidebar:FindFirstChildOfClass("UIPadding").PaddingLeft = UDim.new(0, 10)
