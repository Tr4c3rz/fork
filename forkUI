local _cloneref = (typeof(cloneref) == "function") and cloneref or nil

local function getService(name)
    local ok, service = pcall(game.GetService, game, name)
    if not ok or service == nil then return nil end
    if _cloneref then
        local okClone, cloned = pcall(_cloneref, service)
        if okClone and cloned then return cloned end
    end
    return service
end

local Players = getService("Players")
local TweenService = getService("TweenService")
local UserInputService = getService("UserInputService")
local Workspace = getService("Workspace")

local Library = {}
Library.__index = Library

Library.Version = "0.3.0"

local DEFAULT_THEME = {
    Background = Color3.fromRGB(15, 16, 22),
    Secondary = Color3.fromRGB(22, 24, 33),
    Tertiary = Color3.fromRGB(30, 33, 44),
    Accent = Color3.fromRGB(110, 90, 255),
    Text = Color3.fromRGB(240, 241, 248),
    Muted = Color3.fromRGB(145, 149, 165),
    Border = Color3.fromRGB(48, 51, 65),
    Success = Color3.fromRGB(80, 200, 130),
    Danger = Color3.fromRGB(235, 85, 95),
}

local function create(className, properties, parent)
    local object = Instance.new(className)
    for property, value in pairs(properties or {}) do
        object[property] = value
    end
    object.Parent = parent
    return object
end

local function corner(parent, radius)
    return create("UICorner", {
        CornerRadius = UDim.new(0, radius or 8)
    }, parent)
end

local function stroke(parent, color, transparency)
    return create("UIStroke", {
        Color = color,
        Transparency = transparency or 0,
        Thickness = 1
    }, parent)
end

local function padding(parent, left, right, top, bottom)
    return create("UIPadding", {
        PaddingLeft = UDim.new(0, left or 0),
        PaddingRight = UDim.new(0, right or 0),
        PaddingTop = UDim.new(0, top or 0),
        PaddingBottom = UDim.new(0, bottom or 0),
    }, parent)
end

local function tween(object, duration, properties, style, direction)
    local animation = TweenService:Create(
        object,
        TweenInfo.new(duration or 0.2, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out),
        properties
    )
    animation:Play()
    return animation
end

local function surface(object)
    object:SetAttribute("ForkSurface", true)
    return object
end

local function lighten(color, amount)
    return color:Lerp(Color3.new(1, 1, 1), amount)
end

local function hoverFx(object, getBase, getHover)
    object.MouseEnter:Connect(function()
        tween(object, 0.15, {BackgroundColor3 = getHover and getHover() or lighten(getBase(), 0.08)})
    end)
    object.MouseLeave:Connect(function()
        tween(object, 0.2, {BackgroundColor3 = getBase()})
    end)
end

local function pressFx(object)
    local scale = create("UIScale", {Scale = 1}, object)
    local function release()
        tween(scale, 0.2, {Scale = 1}, Enum.EasingStyle.Back)
    end
    object.MouseButton1Down:Connect(function()
        tween(scale, 0.1, {Scale = 0.95})
    end)
    object.MouseButton1Up:Connect(release)
    object.MouseLeave:Connect(release)
    object.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            release()
        end
    end)
end

local function focusFx(box, color)
    local outline = stroke(box, color, 1)
    box.Focused:Connect(function()
        tween(outline, 0.15, {Transparency = 0})
    end)
    box.FocusLost:Connect(function()
        tween(outline, 0.2, {Transparency = 1})
    end)
    return outline
end

local function chevron(parent, color)
    local holder = create("Frame", {
        Name = "Chevron",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
