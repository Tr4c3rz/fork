                hoverFx(button, function() return theme.Tertiary end)
                local valueLabel = makeLabel(button, tostring(selected or "Select"), 11, theme.Text)
                valueLabel.Position = UDim2.fromOffset(10, 0)
                valueLabel.Size = UDim2.new(1, -32, 1, 0)
                valueLabel.TextTruncate = Enum.TextTruncate.AtEnd
                local arrow = chevron(button, theme.Muted)

                local menu = create("ScrollingFrame", {
                    Visible = false,
                    Position = UDim2.new(0, 0, 0, 40),
                    Size = UDim2.new(1, 0, 0, 0),
                    BackgroundColor3 = theme.Tertiary,
                    BorderSizePixel = 0,
                    CanvasSize = UDim2.new(),
                    AutomaticCanvasSize = Enum.AutomaticSize.Y,
                    ScrollBarThickness = 2,
                    ScrollBarImageColor3 = theme.Accent,
                    ClipsDescendants = true,
                }, row)
                corner(menu, 6)
                stroke(menu, theme.Border, 0.45)
                create("UIListLayout", {
                    Padding = UDim.new(0, 3),
                    SortOrder = Enum.SortOrder.LayoutOrder,
                }, menu)
                padding(menu, 5, 5, 5, 5)

                local function menuHeight()
                    local count = #values
                    if count == 0 then return 10 end
                    return math.min(count * 27 + (count - 1) * 3 + 10, 170)
                end

                local isOpen = false
                local closeSelf
                local function setOpen(state)
                    isOpen = state
                    if state then
                        if window._closeDropdown and window._closeDropdown ~= closeSelf then
                            window._closeDropdown()
                        end
                        window._closeDropdown = closeSelf
                    elseif window._closeDropdown == closeSelf then
                        window._closeDropdown = nil
                    end
                    tween(arrow, 0.22, {Rotation = isOpen and 180 or 0})
                    if isOpen then
                        local height = menuHeight()
                        menu.Visible = true
                        tween(menu, 0.26, {Size = UDim2.new(1, 0, 0, height)})
                        tween(row, 0.26, {Size = UDim2.new(1, 0, 0, 40 + height + 2)})
                    else
                        tween(menu, 0.18, {Size = UDim2.new(1, 0, 0, 0)}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
                        tween(row, 0.18, {Size = UDim2.new(1, 0, 0, 36)}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
                        task.delay(0.19, function()
                            if not isOpen then menu.Visible = false end
                        end)
                    end
                end
                closeSelf = function()
                    setOpen(false)
                end

                local function choose(option)
                    selected = option
                    valueLabel.Text = tostring(option)
                    setOpen(false)
                    if config.Callback then config.Callback(option) end
                end
                local function rebuildOptions()
                    for _, child in ipairs(menu:GetChildren()) do
                        if child:IsA("TextButton") then child:Destroy() end
                    end
                    for index, option in ipairs(values) do
                        local optionButton = create("TextButton", {
                            LayoutOrder = index,
                            Size = UDim2.new(1, 0, 0, 27),
                            BackgroundColor3 = theme.Secondary,
                            Text = tostring(option),
                            TextColor3 = theme.Text,
                            TextSize = 11,
                            Font = Enum.Font.Gotham,
                            AutoButtonColor = false,
                            ZIndex = 6,
                        }, menu)
                        corner(optionButton, 4)
                        hoverFx(optionButton, function() return theme.Secondary end)
                        optionButton.MouseButton1Click:Connect(function() choose(option) end)
                    end
                end
                rebuildOptions()
                button.MouseButton1Click:Connect(function()
                    setOpen(not isOpen)
                end)
                local api = {}
                function api:Set(option)
                    if table.find(values, option) then choose(option) end
                end
                function api:Get() return selected end
                registerFlag("Dropdown", config, function() return selected end, function(v) api:Set(v) end)
                function api:SetOptions(newOptions, defaultOption)
                    values = newOptions or {}
                    selected = defaultOption or values[1]
                    valueLabel.Text = tostring(selected or "Select")
                    rebuildOptions()
                    if isOpen then
                        local height = menuHeight()
                        menu.Size = UDim2.new(1, 0, 0, height)
                        row.Size = UDim2.new(1, 0, 0, 40 + height + 2)
                    end
                end
                return api
            end

            function sectionApi:CreateColorPicker(config)
                config = config or {}
                local current = typeof(config.Default) == "Color3" and config.Default or theme.Accent
                local row = makeRow(88)
                local label = makeLabel(row, config.Name or "Color", 12, theme.Text, Enum.Font.GothamMedium)
                label.Size = UDim2.new(1, -55, 0, 20)
                local preview = create("Frame", {
                    AnchorPoint = Vector2.new(1, 0),
                    Position = UDim2.new(1, 0, 0, 0),
                    Size = UDim2.fromOffset(42, 20),
                    BackgroundColor3 = current,
                    BorderSizePixel = 0,
                }, row)
                corner(preview, 5)
                local rgbBoxes = {}
                local labels = {"R", "G", "B"}
                local channels = {current.R * 255, current.G * 255, current.B * 255}
                for index, channelName in ipairs(labels) do
                    local x = (index - 1) * 48
                    local channelLabel = makeLabel(row, channelName, 9, theme.Muted)
                    channelLabel.Position = UDim2.fromOffset(x, 27)
                    channelLabel.Size = UDim2.fromOffset(12, 22)
                    local box = create("TextBox", {
                        Position = UDim2.fromOffset(x + 13, 27),
                        Size = UDim2.fromOffset(34, 23),
                        BackgroundColor3 = theme.Tertiary,
                        Text = tostring(math.floor(channels[index] + 0.5)),
                        TextColor3 = theme.Text,
                        PlaceholderText = "0",
                        TextSize = 10,
                        Font = Enum.Font.Gotham,
                        ClearTextOnFocus = false,
                    }, row)
                    corner(box, 5)
                    focusFx(box, theme.Accent)
                    rgbBoxes[index] = box
                end
                local hexBox = create("TextBox", {
                    Position = UDim2.fromOffset(0, 58),
                    Size = UDim2.fromOffset(145, 24),
                    BackgroundColor3 = theme.Tertiary,
                    Text = "#" .. current:ToHex(),
                    TextColor3 = theme.Text,
                    PlaceholderText = "#RRGGBB",
                    TextSize = 10,
                    Font = Enum.Font.Gotham,
                    ClearTextOnFocus = false,
                }, row)
                corner(hexBox, 5)
                focusFx(hexBox, theme.Accent)

                local function updateColor(color, fire)
                    current = color
                    preview.BackgroundColor3 = color
                    local r, g, b = color.R * 255, color.G * 255, color.B * 255
                    local values = {r, g, b}
                    for i, box in ipairs(rgbBoxes) do
                        box.Text = tostring(math.floor(values[i] + 0.5))
                    end
                    hexBox.Text = "#" .. color:ToHex()
                    if fire and config.Callback then config.Callback(color) end
                end
                local function fromRGBBoxes()
                    local values = {}
                    for i, box in ipairs(rgbBoxes) do
                        values[i] = math.clamp(tonumber(box.Text) or 0, 0, 255)
                    end
                    updateColor(Color3.fromRGB(values[1], values[2], values[3]), true)
                end
                for _, box in ipairs(rgbBoxes) do
                    box.FocusLost:Connect(fromRGBBoxes)
                end
                hexBox.FocusLost:Connect(function()
                    local hex = hexBox.Text:gsub("#", "")
                    if #hex == 6 and hex:match("^%x%x%x%x%x%x$") then
                        local r = tonumber(hex:sub(1, 2), 16)
                        local g = tonumber(hex:sub(3, 4), 16)
                        local b = tonumber(hex:sub(5, 6), 16)
                        updateColor(Color3.fromRGB(r, g, b), true)
                    else
                        hexBox.Text = "#" .. current:ToHex()
                    end
                end)
                local api = {}
                function api:Set(color)
                    if typeof(color) == "Color3" then updateColor(color, true) end
                end
                function api:Get() return current end
                registerFlag("ColorPicker", config, function() return colorToTable(current) end, function(v)
                    local color = tableToColor(v)
                    if color then api:Set(color) end
                end)
                return api
            end

