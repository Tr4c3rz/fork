    window.Flags = {}
    local function folderSafe(text)
        local cleaned = tostring(text or ""):gsub("[^%w%-%_]", "_")
        return cleaned
    end
    local scriptId = tostring(options.Folder or options.Name or "default")
    local configFolder = options.Folder and tostring(options.Folder) or ("fork/" .. folderSafe(options.Name or "default"))
    local configDirectory = configFolder .. "/configs"
    local autoloadPath = configFolder .. "/autoload.txt"
    local memoryConfigs = {}
    local memoryAutoload = nil

    local function fileSupport()
        return typeof(writefile) == "function"
            and typeof(readfile) == "function"
            and typeof(isfile) == "function"
    end

    local function ensureFolders()
        if typeof(makefolder) ~= "function" then return end
        local paths = {}
        local built
        for part in string.gmatch(configDirectory, "[^/]+") do
            built = built and (built .. "/" .. part) or part
            table.insert(paths, built)
        end
        for _, path in ipairs(paths) do
            local exists = false
            if typeof(isfolder) == "function" then
                local ok, result = pcall(isfolder, path)
                exists = ok and result == true
            end
            if not exists then
                pcall(makefolder, path)
            end
        end
    end

    local function cleanName(name)
        local cleaned = tostring(name or ""):gsub("[^%w%s%-%_%.]", ""):gsub("^%s+", ""):gsub("%s+$", "")
        return cleaned
    end

    local function configPath(name)
        return configDirectory .. "/" .. name .. ".json"
    end

    local function buildConfig()
        local themeData = {}
        for key, value in pairs(theme) do
            if typeof(value) == "Color3" then
                themeData[key] = colorToTable(value)
            end
        end
        local flags = {}
        for flag, entry in pairs(window.Flags) do
            local ok, value = pcall(entry.Get)
            if ok and value ~= nil then
                flags[flag] = value
            end
        end
        return {
            Version = 1,
            Script = scriptId,
            Theme = themeData,
            Appearance = {
                Opacity = window.Opacity,
                BackgroundImage = window.BackgroundImage or "",
                BackgroundImageOpacity = window.BackgroundImageOpacity,
                SizeScale = window.SizeScale,
            },
            Flags = flags,
        }
    end

    local function applyConfig(data)
        if type(data.Theme) == "table" then
            local colors = {}
            for key, value in pairs(data.Theme) do
                local color = tableToColor(value)
                if color then colors[key] = color end
            end
            window:SetTheme(colors)
        end

        local appearance = data.Appearance
        if type(appearance) == "table" then
            if tonumber(appearance.Opacity) then
                window:SetOpacity(appearance.Opacity)
            end
            if type(appearance.BackgroundImage) == "string" then
                window:SetBackgroundImage(appearance.BackgroundImage)
            end
            if tonumber(appearance.BackgroundImageOpacity) then
                window:SetBackgroundImageOpacity(appearance.BackgroundImageOpacity)
            end
            if tonumber(appearance.SizeScale) then
                window:SetSize(appearance.SizeScale * 100)
            end
            local controls = window._settingsControls
            if controls then
                controls.Opacity:Set(math.floor(window.Opacity * 100 + 0.5))
                controls.ImageOpacity:Set(math.floor((1 - window.BackgroundImageOpacity) * 100 + 0.5))
                controls.Size:Set(math.floor(window.SizeScale * 100 + 0.5))
                controls.Background.Text = window.BackgroundImage or ""
            end
        end

        if type(data.Flags) == "table" then
            for flag, value in pairs(data.Flags) do
                local entry = window.Flags[flag]
                if entry then
                    pcall(entry.Set, value)
                end
            end
        end
    end

    function window:SaveConfig(name)
        name = cleanName(name)
        if name == "" then return false, "Config name is required" end
        if not HttpService then return false, "HttpService is unavailable" end
        local okEncode, encoded = pcall(HttpService.JSONEncode, HttpService, buildConfig())
        if not okEncode then return false, "Could not encode config" end
        if fileSupport() then
            ensureFolders()
            local okWrite, err = pcall(writefile, configPath(name), encoded)
            if not okWrite then return false, "Could not write file: " .. tostring(err) end
            return true
        end
        memoryConfigs[name] = encoded
        return true, "Saved in memory only (this executor has no file support)"
    end

    function window:LoadConfig(name)
        name = cleanName(name)
        if name == "" then return false, "Select a config first" end
        if not HttpService then return false, "HttpService is unavailable" end
        local raw
        if fileSupport() then
            local path = configPath(name)
            local okExists, exists = pcall(isfile, path)
            if not (okExists and exists) then return false, "Config not found" end
            local okRead, content = pcall(readfile, path)
            if not okRead then return false, "Could not read config" end
            raw = content
        else
            raw = memoryConfigs[name]
            if not raw then return false, "Config not found" end
        end
        local okDecode, data = pcall(HttpService.JSONDecode, HttpService, raw)
        if not okDecode or type(data) ~= "table" then return false, "Config file is corrupted" end
        if data.Script ~= nil and tostring(data.Script) ~= scriptId then
            return false, "Config belongs to a different script"
        end
        applyConfig(data)
        return true
    end

    function window:DeleteConfig(name)
        name = cleanName(name)
        if name == "" then return false, "Select a config first" end
        if fileSupport() then
            local path = configPath(name)
            local okExists, exists = pcall(isfile, path)
            if not (okExists and exists) then return false, "Config not found" end
            if typeof(delfile) ~= "function" then return false, "This executor cannot delete files" end
            local okDelete = pcall(delfile, path)
            if not okDelete then return false, "Could not delete config" end
        else
            if not memoryConfigs[name] then return false, "Config not found" end
            memoryConfigs[name] = nil
        end
        if window:GetAutoload() == name then
            window:SetAutoload(nil)
        end
        return true
    end

    function window:RenameConfig(oldName, newName)
        oldName = cleanName(oldName)
        newName = cleanName(newName)
        if oldName == "" then return false, "Select a config first" end
        if newName == "" then return false, "Type the new name in the Config name box" end
        if oldName == newName then return true end
        if fileSupport() then
            local oldPath = configPath(oldName)
            local okExists, exists = pcall(isfile, oldPath)
            if not (okExists and exists) then return false, "Config not found" end
            if typeof(delfile) ~= "function" then return false, "This executor cannot rename files" end
            local okRead, content = pcall(readfile, oldPath)
            if not okRead then return false, "Could not read config" end
            ensureFolders()
            local okWrite = pcall(writefile, configPath(newName), content)
            if not okWrite then return false, "Could not write config" end
            pcall(delfile, oldPath)
        else
            if not memoryConfigs[oldName] then return false, "Config not found" end
            memoryConfigs[newName] = memoryConfigs[oldName]
            memoryConfigs[oldName] = nil
        end
        if window:GetAutoload() == oldName then
            window:SetAutoload(newName)
        end
        return true
    end

    function window:GetConfigs()
        local names = {}
        if fileSupport() then
            if typeof(listfiles) == "function" then
                ensureFolders()
                local ok, files = pcall(listfiles, configDirectory)
                if ok and type(files) == "table" then
                    for _, path in ipairs(files) do
                        local name = tostring(path):match("([^/\\]+)%.json$")
                        if name then table.insert(names, name) end
                    end
                end
            end
        else
            for name in pairs(memoryConfigs) do
                table.insert(names, name)
            end
        end
        table.sort(names)
        return names
    end

    function window:SetAutoload(name)
        name = cleanName(name)
        if fileSupport() then
            ensureFolders()
            local ok = pcall(writefile, autoloadPath, name)
            return ok
        end
        memoryAutoload = name ~= "" and name or nil
        return true
    end

    function window:GetAutoload()
        local name
        if fileSupport() then
            local okExists, exists = pcall(isfile, autoloadPath)
            if okExists and exists then
                local okRead, content = pcall(readfile, autoloadPath)
                if okRead then name = cleanName(content) end
            end
        else
            name = memoryAutoload
        end
        if name == "" then name = nil end
        return name
    end

    function window:LoadAutoload()
        window._autoloaded = true
        local name = window:GetAutoload()
        if not name then return false, "No autoload config set" end
        local ok, message = window:LoadConfig(name)
        if ok then
            window:Notify({
                Type = "success",
                Title = "Config loaded",
                Content = "Autoloaded '" .. name .. "'.",
            })
        end
        return ok, message
    end

