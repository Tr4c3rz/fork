            function sectionApi:CreateSlider(config)
                config = config or {}
                local min = config.Min or 0
                local max = config.Max or 100
                local increment = config.Increment or ((max - min) <= 2 and 0.01 or 1)
                local decimals = 0
                local probe = increment
                while decimals < 4 and math.abs(probe - math.floor(probe + 0.5)) > 0.000001 do
                    probe = probe * 10
                    decimals = decimals + 1
                end
                local function snap(raw)
                    local snapped = math.floor((raw - min) / increment + 0.5) * increment + min
                    snapped = math.clamp(snapped, min, max)
                    return tonumber(string.format("%." .. decimals .. "f", snapped))
                end
                local function formatValue(number)
                    return string.format("%." .. decimals .. "f", number)
                end
                local function toAlpha(number)
                    return (number - min) / math.max(max - min, 0.0001)
                end

                local value = snap(config.Default or min)
                local row = makeRow(53)
                local label = makeLabel(row, config.Name or "Slider", 12, theme.Text, Enum.Font.GothamMedium)
                label.Size = UDim2.new(1, -65, 0, 18)
                local valueLabel = makeLabel(row, formatValue(value), 11, theme.Muted)
                valueLabel.TextXAlignment = Enum.TextXAlignment.Right
                valueLabel.Position = UDim2.new(1, -55, 0, 0)
                valueLabel.Size = UDim2.fromOffset(55, 18)
                local bar = create("TextButton", {
                    Position = UDim2.fromOffset(0, 29),
                    Size = UDim2.new(1, 0, 0, 7),
                    BackgroundColor3 = theme.Tertiary,
                    Text = "",
                    AutoButtonColor = false,
                }, row)
                corner(bar, 8)
                local fill = create("Frame", {
                    Size = UDim2.new(toAlpha(value), 0, 1, 0),
                    BackgroundColor3 = theme.Accent,
                    BorderSizePixel = 0,
                }, bar)
                corner(fill, 8)
                local knob = create("Frame", {
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.new(toAlpha(value), 0, 0.5, 0),
                    Size = UDim2.fromOffset(11, 11),
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    BorderSizePixel = 0,
                    ZIndex = 2,
                }, bar)
                corner(knob, 20)

                local api = {}
                local function setValue(nextValue, fire, force)
                    local snapped = snap(nextValue)
                    local changed = snapped ~= value
                    value = snapped
                    local alpha = toAlpha(value)
                    tween(fill, 0.1, {Size = UDim2.new(alpha, 0, 1, 0)}, Enum.EasingStyle.Quad)
                    tween(knob, 0.1, {Position = UDim2.new(alpha, 0, 0.5, 0)}, Enum.EasingStyle.Quad)
                    valueLabel.Text = formatValue(value)
                    if fire and (changed or force) and config.Callback then
                        config.Callback(value)
                    end
                end
                local function update(input)
                    local alpha = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                    setValue(min + (max - min) * alpha, true)
                end
                local sliding = false
                local function setSliding(state)
                    sliding = state
                    tween(knob, 0.18, {
                        Size = state and UDim2.fromOffset(15, 15) or UDim2.fromOffset(11, 11)
                    }, Enum.EasingStyle.Back)
                end
                bar.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        setSliding(true)
                        update(input)
                    end
                end)
                connect(UserInputService.InputChanged, function(input)
                    if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement
                        or input.UserInputType == Enum.UserInputType.Touch) then update(input) end
                end)
                connect(UserInputService.InputEnded, function(input)
                    if sliding and (input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch) then setSliding(false) end
                end)
                function api:Set(nextValue) setValue(nextValue, true, true) end
                function api:Get() return value end
                return api
            end

