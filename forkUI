    function window:SetTheme(newTheme)
        local previous = {}
        for key, value in pairs(theme) do previous[key] = value end
        for key, value in pairs(newTheme or {}) do
            if theme[key] ~= nil and typeof(value) == "Color3" then
                theme[key] = value
            end
        end

        for _, descendant in ipairs(main:GetDescendants()) do
            if descendant:IsA("GuiObject") then
                if descendant.BackgroundColor3 == previous.Accent then
                    descendant.BackgroundColor3 = theme.Accent
                elseif descendant.BackgroundColor3 == previous.Background then
                    descendant.BackgroundColor3 = theme.Background
                elseif descendant.BackgroundColor3 == previous.Secondary then
                    descendant.BackgroundColor3 = theme.Secondary
                elseif descendant.BackgroundColor3 == previous.Tertiary then
                    descendant.BackgroundColor3 = theme.Tertiary
                end

                if descendant:IsA("TextLabel") or descendant:IsA("TextButton") or descendant:IsA("TextBox") then
                    if descendant.TextColor3 == previous.Accent then
                        descendant.TextColor3 = theme.Accent
                    elseif descendant.TextColor3 == previous.Text then
                        descendant.TextColor3 = theme.Text
                    elseif descendant.TextColor3 == previous.Muted then
                        descendant.TextColor3 = theme.Muted
                    end
                    if descendant:IsA("TextLabel") and descendant.Name == "SectionTitle" then
                        descendant.TextColor3 = theme.Accent
                    end
                end
                if descendant:IsA("ScrollingFrame") then
                    descendant.ScrollBarImageColor3 = theme.Accent
                end
            elseif descendant:IsA("UIStroke") and descendant.Color == previous.Border then
                descendant.Color = theme.Border
            end
        end

        main.BackgroundColor3 = theme.Background
        topbar.BackgroundColor3 = theme.Secondary
        sidebar.BackgroundColor3 = theme.Secondary
        reopen.BackgroundColor3 = theme.Secondary
        reopen.TextColor3 = theme.Accent
        for _, tab in ipairs(window.Tabs) do
            tab.Page.ScrollBarImageColor3 = theme.Accent
        end
    end

    function window:SetAccent(color)
        if typeof(color) == "Color3" then self:SetTheme({Accent = color}) end
    end

    function window:SetOpacity(value)
        window.Opacity = math.clamp(tonumber(value) or 0, 0, 0.9)
        for _, object in ipairs(main:GetDescendants()) do
            if object:IsA("Frame") or object:IsA("TextButton") or object:IsA("TextBox") or object:IsA("ScrollingFrame") then
                if object.Name ~= "BackgroundImage" then
                    object.BackgroundTransparency = window.Opacity
                end
            end
        end
        main.BackgroundTransparency = window.Opacity
    end

    function window:SetBackgroundImage(asset)
        local image = resolveImage(asset)
        backgroundImage.Image = image
        window.BackgroundImage = image
    end

    function window:SetBackgroundImageOpacity(value)
        window.BackgroundImageOpacity = math.clamp(tonumber(value) or 0, 0, 1)
        backgroundImage.ImageTransparency = window.BackgroundImageOpacity
    end

    function window:SetSize(scale)
        local amount = math.clamp(tonumber(scale) or 100, 60, 120) / 100
        local camera = Workspace.CurrentCamera
        if UserInputService.TouchEnabled and camera and camera.ViewportSize.X < 900 then
            main.Size = UDim2.new(math.min(0.98, 0.94 * amount), 0, math.min(0.9, 0.78 * amount), 0)
        else
            local base = options.Size or UDim2.fromOffset(650, 420)
            main.Size = UDim2.fromOffset(base.X.Offset * amount, base.Y.Offset * amount)
        end
    end

    window.SavedThemes = {}

    function window:SaveTheme(name)
        name = tostring(name or ""):gsub("^%s+", ""):gsub("%s+$", "")
        if name == "" then return false, "Theme name is required" end
        local snapshot = {}
        for key, value in pairs(theme) do snapshot[key] = value end
        self.SavedThemes[name] = snapshot
        return true
    end

    function window:LoadTheme(name)
        local saved = self.SavedThemes[name]
        if not saved then return false, "Theme not found" end
        self:SetTheme(saved)
        return true
    end

    function window:RenameTheme(oldName, newName)
        newName = tostring(newName or ""):gsub("^%s+", ""):gsub("%s+$", "")
        if not self.SavedThemes[oldName] then return false, "Theme not found" end
        if newName == "" then return false, "New theme name is required" end
        self.SavedThemes[newName] = self.SavedThemes[oldName]
        self.SavedThemes[oldName] = nil
        return true
    end

    function window:DeleteTheme(name)
        if not self.SavedThemes[name] then return false end
        self.SavedThemes[name] = nil
        return true
    end

    function window:GetSavedThemes()
        local names = {}
        for name in pairs(self.SavedThemes) do table.insert(names, name) end
        table.sort(names)
        return names
    end

