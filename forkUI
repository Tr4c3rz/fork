                button.MouseButton1Click:Connect(function()
                    listening = true
                    button.Text = "Press key..."
                    tween(button, 0.15, {TextColor3 = theme.Accent})
                end)
                connect(UserInputService.InputBegan, function(input, processed)
                    if listening and input.UserInputType == Enum.UserInputType.Keyboard then
                        currentKey = input.KeyCode
                        listening = false
                        button.Text = currentKey.Name
                        tween(button, 0.15, {TextColor3 = theme.Text})
                    elseif not processed and not listening and input.KeyCode == currentKey then
                        if config.Callback then config.Callback(currentKey) end
                    end
                end)
                local api = {}
                function api:Set(keyCode)
                    if typeof(keyCode) == "EnumItem" and keyCode.EnumType == Enum.KeyCode then
                        currentKey = keyCode
                        button.Text = keyCode.Name
                    end
                end
                function api:Get() return currentKey end
                registerFlag("Keybind", config, function() return currentKey.Name end, function(v)
                    local ok, key = pcall(function() return Enum.KeyCode[v] end)
                    if ok and key then api:Set(key) end
                end)
                return api
            end

