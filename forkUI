    }, parent)
end

local function resolveGuiParent(preferred)
    if typeof(preferred) == "Instance" then
        return preferred
    end

    if typeof(gethui) == "function" then
        local ok, hui = pcall(gethui)
        if ok and typeof(hui) == "Instance" then
            return hui
        end
    end

    local coreGui = getService("CoreGui")
    if coreGui then
        local ok = pcall(function()
            local probe = Instance.new("Folder")
            probe.Parent = coreGui
            probe:Destroy()
        end)
        if ok then
            return coreGui
        end
    end

    local player = Players and Players.LocalPlayer
    assert(player, "fork must run on the client (Players.LocalPlayer not found)")
    return player:WaitForChild("PlayerGui", 10) or error("fork could not find PlayerGui")
end

local function resolveImage(asset)
    local image = tostring(asset or "")
    if image == "" then return "" end
    if image:match("^rbxassetid://") or image:match("^rbxasset://") or image:match("^rbxthumb://") then
        return image
    end
    if image:match("^%d+$") then
        return "rbxassetid://" .. image
    end
    if image:match("^https?://") then
        return image
    end
    local getAsset = getcustomasset or getsynasset
    if typeof(getAsset) == "function" then
        local ok, result = pcall(getAsset, image)
        if ok and type(result) == "string" then
            return result
        end
    end
    return "rbxassetid://" .. image
end

local function initialsOf(name)
    local letters = ""
    for word in string.gmatch(tostring(name or ""), "%w+") do
        if #letters < 2 then
            letters = letters .. string.upper(string.sub(word, 1, 1))
        end
    end
    if letters == "" then
        letters = "F"
    end
    return letters
end

local function colorToTable(color)
    return {
        math.floor(color.R * 255 + 0.5),
        math.floor(color.G * 255 + 0.5),
        math.floor(color.B * 255 + 0.5),
    }
end

local function tableToColor(value)
    if type(value) == "table" and tonumber(value[1]) and tonumber(value[2]) and tonumber(value[3]) then
        return Color3.fromRGB(
            math.clamp(value[1], 0, 255),
            math.clamp(value[2], 0, 255),
            math.clamp(value[3], 0, 255)
        )
    end
    return nil
end

local function mergeTheme(custom)
    local result = {}
    for key, value in pairs(DEFAULT_THEME) do
        result[key] = value
    end
    for key, value in pairs(custom or {}) do
        if result[key] ~= nil and typeof(value) == "Color3" then
            result[key] = value
        end
    end
    return result
end

function Library:CreateWindow(options)
    options = options or {}

    local theme = mergeTheme(options.Theme)
    local window = {
        Theme = theme,
        Tabs = {},
        CurrentTab = nil,
        Destroyed = false,
        Opacity = options.Opacity or 0,
        BackgroundImage = nil,
        BackgroundImageOpacity = options.BackgroundImageOpacity or 0.82,
    }

    local guiName = options.GuiName or "forkUI"
    local guiParent = resolveGuiParent(options.Parent)

    for _, child in ipairs(guiParent:GetChildren()) do
        if child.Name == guiName and child:GetAttribute("ForkUI") then
            child:Destroy()
        end
    end

    local connections = {}
    local function connect(signal, callback)
        local connection = signal:Connect(callback)
        table.insert(connections, connection)
        return connection
    end

    local screenGui = create("ScreenGui", {
        Name = guiName,
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    })
    screenGui:SetAttribute("ForkUI", true)
    if typeof(syn) == "table" and typeof(syn.protect_gui) == "function" then
        pcall(syn.protect_gui, screenGui)
    end
    screenGui.Parent = guiParent
    screenGui.Destroying:Connect(function()
        window.Destroyed = true
        for _, connection in ipairs(connections) do
            connection:Disconnect()
        end
        table.clear(connections)
    end)

    local main = create("CanvasGroup", {
        Name = "Main",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(0, 0),
        BackgroundColor3 = theme.Background,
        BackgroundTransparency = window.Opacity,
        BorderSizePixel = 0,
        ClipsDescendants = true,
    }, screenGui)
    corner(main, 12)
    stroke(main, theme.Border)
    surface(main)
    local mainScale = create("UIScale", {Scale = 1}, main)

    local backgroundImage = create("ImageLabel", {
        Name = "BackgroundImage",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Image = resolveImage(options.BackgroundImage),
        ImageTransparency = window.BackgroundImageOpacity,
        ScaleType = Enum.ScaleType.Crop,
        ZIndex = 0,
    }, main)

    local topbar = create("Frame", {
        Name = "Topbar",
        Size = UDim2.new(1, 0, 0, 48),
        BackgroundColor3 = theme.Secondary,
        BackgroundTransparency = window.Opacity,
        BorderSizePixel = 0,
        ZIndex = 2,
    }, main)
    corner(topbar, 12)
    surface(topbar)
    create("Frame", {
        Name = "Divider",
        Position = UDim2.new(0, 0, 0, 47),
        Size = UDim2.new(1, 0, 0, 1),
        BackgroundColor3 = theme.Border,
        BorderSizePixel = 0,
        ZIndex = 3,
    }, main)

    surface(create("Frame", {
        Position = UDim2.new(0, 0, 1, -12),
        Size = UDim2.new(1, 0, 0, 12),
        BackgroundColor3 = theme.Secondary,
        BackgroundTransparency = window.Opacity,
        BorderSizePixel = 0,
    }, topbar))

    local title = makeLabel(topbar, options.Name or "fork", 15, theme.Text, Enum.Font.GothamBold)
    title.Position = UDim2.fromOffset(17, 0)
    title.Size = UDim2.new(1, -145, 1, 0)
    title.TextTruncate = Enum.TextTruncate.AtEnd

    local navToggle = create("TextButton", {
        Name = "NavigationToggle",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -86, 0.5, 0),
        Size = UDim2.fromOffset(28, 28),
        BackgroundColor3 = theme.Tertiary,
        Text = "",
        TextColor3 = theme.Muted,
        TextSize = 16,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false,
    }, topbar)
    corner(navToggle, 7)
    for index = 1, 3 do
        local bar = create("Frame", {
            Name = "Glyph",
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, 0, 0.5, (index - 2) * 5),
            Size = UDim2.fromOffset(12, 2),
            BackgroundColor3 = theme.Muted,
            BorderSizePixel = 0,
        }, navToggle)
        corner(bar, 1)
    end

    local minimize = create("TextButton", {
        Name = "Minimize",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -48, 0.5, 0),
        Size = UDim2.fromOffset(28, 28),
        BackgroundColor3 = theme.Tertiary,
        Text = "−",
        TextColor3 = theme.Muted,
        TextSize = 20,
        Font = Enum.Font.Gotham,
        AutoButtonColor = false,
    }, topbar)
    corner(minimize, 7)

    local close = create("TextButton", {
        Name = "Close",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -13, 0.5, 0),
        Size = UDim2.fromOffset(28, 28),
        BackgroundColor3 = theme.Tertiary,
        Text = "×",
        TextColor3 = theme.Muted,
        TextSize = 22,
        Font = Enum.Font.Gotham,
        AutoButtonColor = false,
    }, topbar)
    corner(close, 7)

    hoverFx(navToggle, function() return theme.Tertiary end)
    hoverFx(minimize, function() return theme.Tertiary end)
    hoverFx(close, function() return theme.Tertiary end, function() return theme.Danger end)
    close.MouseEnter:Connect(function()
        tween(close, 0.15, {TextColor3 = Color3.new(1, 1, 1)})
    end)
    close.MouseLeave:Connect(function()
        tween(close, 0.2, {TextColor3 = theme.Muted})
    end)

    local reopenText = tostring(options.Initials or initialsOf(options.Name or "fork"))
    local reopen = create("TextButton", {
        Name = "ForkReopen",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0, 62),
        Size = UDim2.fromOffset(32, 32),
        BackgroundColor3 = theme.Secondary,
        Text = reopenText,
        TextColor3 = theme.Accent,
        TextSize = #reopenText > 1 and 12 or 15,
        Font = Enum.Font.GothamBold,
        Visible = false,
        AutoButtonColor = false,
        ZIndex = 200,
    }, screenGui)
    corner(reopen, 10)
    stroke(reopen, theme.Border)
    local reopenScale = create("UIScale", {Scale = 1}, reopen)
    hoverFx(reopen, function() return theme.Secondary end)

    local sidebar = create("Frame", {
        Name = "Sidebar",
        Position = UDim2.fromOffset(0, 48),
        Size = UDim2.new(0, 155, 1, -48),
        BackgroundColor3 = theme.Secondary,
        BackgroundTransparency = window.Opacity,
        BorderSizePixel = 0,
        ZIndex = 2,
    }, main)
    padding(sidebar, 10, 10, 13, 10)
    surface(sidebar)

    local tabList = create("ScrollingFrame", {
        Name = "TabList",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 1, 0),
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = theme.Accent,
    }, sidebar)
    create("UIListLayout", {
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, tabList)

    local content = create("Frame", {
        Name = "Content",
        Position = UDim2.new(0, 155, 0, 48),
        Size = UDim2.new(1, -155, 1, -48),
        BackgroundTransparency = 1,
        ClipsDescendants = true,
        ZIndex = 2,
    }, main)

    local mobileMode = false
    local mobileNavExpanded = false
    local introPlaying = options.OpenOnCreate ~= false
    local layoutReady = false
    window.SizeScale = math.clamp(tonumber(options.UISize) or 80, 60, 120) / 100

    local function computeMainSize()
        local amount = window.SizeScale
        if mobileMode then
            return UDim2.new(math.min(0.98, 0.94 * amount), 0, math.min(0.9, 0.78 * amount), 0)
        end
        local base = options.Size or UDim2.fromOffset(650, 420)
        return UDim2.fromOffset(base.X.Offset * amount, base.Y.Offset * amount)
    end

    local function place(object, properties)
        if layoutReady then
            tween(object, 0.24, properties)
        else
            for property, value in pairs(properties) do
                object[property] = value
            end
        end
    end

    local function styleTab(tab, collapsed)
        local button = tab.Button
        local icon = tab.IconImage
        if collapsed then
            button.Text = icon and "" or string.upper(string.sub(tab.Name, 1, 1))
            button.TextXAlignment = Enum.TextXAlignment.Center
            button.TextSize = 14
            tab.Padding.PaddingLeft = UDim.new(0, 0)
            tab.Padding.PaddingRight = UDim.new(0, 0)
            tab.Indicator.Position = UDim2.new(0, 0, 0.5, 0)
            if icon then
                icon.AnchorPoint = Vector2.new(0.5, 0.5)
                icon.Position = UDim2.new(0.5, 0, 0.5, 0)
            end
        else
            local left = icon and 36 or 10
            button.Text = tab.Name
            button.TextXAlignment = Enum.TextXAlignment.Left
            button.TextSize = 12
            tab.Padding.PaddingLeft = UDim.new(0, left)
            tab.Padding.PaddingRight = UDim.new(0, 6)
            tab.Indicator.Position = UDim2.new(0, -left, 0.5, 0)
            if icon then
                icon.AnchorPoint = Vector2.new(0, 0.5)
                icon.Position = UDim2.new(0, -26, 0.5, 0)
            end
        end
    end

    local function applyResponsiveLayout()
        local camera = Workspace.CurrentCamera
        if not camera then return end
        local viewport = camera.ViewportSize
        mobileMode = UserInputService.TouchEnabled and viewport.X < 900
        local sidebarPadding = sidebar:FindFirstChildOfClass("UIPadding")
        if mobileMode then
            local sidebarWidth = mobileNavExpanded and 142 or 58
            local pad = UDim.new(0, mobileNavExpanded and 8 or 5)
            place(sidebar, {Size = UDim2.new(0, sidebarWidth, 1, -48)})
            place(sidebarPadding, {PaddingLeft = pad, PaddingRight = pad})
            place(content, {
                Position = UDim2.new(0, sidebarWidth, 0, 48),
                Size = UDim2.new(1, -sidebarWidth, 1, -48),
            })
            tabList.ScrollBarThickness = 2
            navToggle.Visible = true
            for _, tab in ipairs(window.Tabs) do
                styleTab(tab, not mobileNavExpanded)
            end
        else
            local pad = UDim.new(0, 10)
            place(sidebar, {Size = UDim2.new(0, 155, 1, -48)})
            place(sidebarPadding, {PaddingLeft = pad, PaddingRight = pad})
            place(content, {
                Position = UDim2.new(0, 155, 0, 48),
                Size = UDim2.new(1, -155, 1, -48),
            })
            tabList.ScrollBarThickness = 3
            navToggle.Visible = false
            for _, tab in ipairs(window.Tabs) do
                styleTab(tab, false)
            end
        end
        if not introPlaying then
            place(main, {Size = computeMainSize()})
        end
    end

    navToggle.MouseButton1Click:Connect(function()
        if not mobileMode then return end
        mobileNavExpanded = not mobileNavExpanded
        applyResponsiveLayout()
    end)

    applyResponsiveLayout()
    layoutReady = true
    if Workspace.CurrentCamera then
        connect(Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"), applyResponsiveLayout)
    end

    local dragging = false
    local dragStart, startPosition
    topbar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPosition = main.Position
        end
    end)

    connect(UserInputService.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            local viewport = screenGui.AbsoluteSize
            local x = startPosition.X.Scale * viewport.X + startPosition.X.Offset + delta.X
            local y = startPosition.Y.Scale * viewport.Y + startPosition.Y.Offset + delta.Y
            x = math.clamp(x, 60, math.max(viewport.X - 60, 60))
            y = math.clamp(y, 30, math.max(viewport.Y - 30, 30))
            tween(main, 0.08, {Position = UDim2.fromOffset(x, y)}, Enum.EasingStyle.Quad)
        end
    end)

    connect(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    local isOpen = options.OpenOnCreate ~= false
    local visibilityToken = 0

    local function showMain()
        if isOpen then return end
        isOpen = true
        visibilityToken = visibilityToken + 1
        screenGui.Enabled = true
        main.Visible = true
        reopen.Visible = false
        mainScale.Scale = 0.9
        main.GroupTransparency = 1
        tween(mainScale, 0.35, {Scale = 1}, Enum.EasingStyle.Back)
        tween(main, 0.25, {GroupTransparency = 0})
    end

    local function hideMain()
        if not isOpen then return end
        isOpen = false
        visibilityToken = visibilityToken + 1
        local token = visibilityToken
        tween(mainScale, 0.22, {Scale = 0.9}, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
        tween(main, 0.22, {GroupTransparency = 1}, Enum.EasingStyle.Quad)
        reopenScale.Scale = 0.4
        reopen.Visible = true
        tween(reopenScale, 0.4, {Scale = 1}, Enum.EasingStyle.Back)
        task.delay(0.23, function()
            if token == visibilityToken and not window.Destroyed then
                main.Visible = false
            end
        end)
    end

    minimize.MouseButton1Click:Connect(hideMain)
    close.MouseButton1Click:Connect(hideMain)
    local reopenDragging = false
    local reopenMoved = false
    local reopenStart, reopenOrigin
    reopen.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            reopenDragging = true
            reopenMoved = false
            reopenStart = input.Position
            reopenOrigin = reopen.AbsolutePosition + reopen.AbsoluteSize / 2
        end
    end)
    connect(UserInputService.InputChanged, function(input)
        if reopenDragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - reopenStart
            if not reopenMoved and delta.Magnitude < 6 then return end
            reopenMoved = true
            local viewport = screenGui.AbsoluteSize
            local x = math.clamp(reopenOrigin.X + delta.X, 20, math.max(viewport.X - 20, 20))
            local y = math.clamp(reopenOrigin.Y + delta.Y, 20, math.max(viewport.Y - 20, 20))
            reopen.Position = UDim2.fromOffset(x, y)
        end
    end)
    connect(UserInputService.InputEnded, function(input)
        if reopenDragging and (input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch) then
            reopenDragging = false
            if not reopenMoved then
                showMain()
            end
        end
    end)

    function window:SetVisible(visible)
        if visible == true then
            showMain()
        else
            hideMain()
        end
    end

    function window:Toggle()
        self:SetVisible(not isOpen)
    end

    function window:SetTheme(newTheme)
        local previous = {}
        for key, value in pairs(theme) do previous[key] = value end
        for key, value in pairs(newTheme or {}) do
            if theme[key] ~= nil and typeof(value) == "Color3" then
                theme[key] = value
            end
        end

        local targets = main:GetDescendants()
        local notifications = screenGui:FindFirstChild("Notifications")
        if notifications then
            for _, descendant in ipairs(notifications:GetDescendants()) do
                table.insert(targets, descendant)
            end
        end

        for _, descendant in ipairs(targets) do
            if descendant:IsA("GuiObject") then
                if descendant.BackgroundColor3 == previous.Accent then
                    descendant.BackgroundColor3 = theme.Accent
                elseif descendant.BackgroundColor3 == previous.Background then
                    descendant.BackgroundColor3 = theme.Background
                elseif descendant.BackgroundColor3 == previous.Secondary then
                    descendant.BackgroundColor3 = theme.Secondary
                elseif descendant.BackgroundColor3 == previous.Tertiary then
                    descendant.BackgroundColor3 = theme.Tertiary
                end

                if descendant:IsA("TextLabel") or descendant:IsA("TextButton") or descendant:IsA("TextBox") then
                    if descendant.TextColor3 == previous.Accent then
                        descendant.TextColor3 = theme.Accent
                    elseif descendant.TextColor3 == previous.Text then
                        descendant.TextColor3 = theme.Text
                    elseif descendant.TextColor3 == previous.Muted then
                        descendant.TextColor3 = theme.Muted
                    end
                    if descendant:IsA("TextLabel") and descendant.Name == "SectionTitle" then
                        descendant.TextColor3 = theme.Accent
                    end
                end
                if descendant:IsA("ScrollingFrame") then
                    descendant.ScrollBarImageColor3 = theme.Accent
                end
                if descendant.Name == "Glyph" then
                    descendant.BackgroundColor3 = theme.Muted
                elseif descendant.Name == "Divider" then
                    descendant.BackgroundColor3 = theme.Border
                end
            elseif descendant:IsA("UIStroke") then
                if descendant.Color == previous.Border then
                    descendant.Color = theme.Border
                elseif descendant.Color == previous.Accent then
                    descendant.Color = theme.Accent
                end
            end
        end

        main.BackgroundColor3 = theme.Background
