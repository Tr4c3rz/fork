            end

            local function rowLabel(row, text, description)
                local label = makeLabel(row, text or "Element", 12, theme.Text, Enum.Font.GothamMedium)
                label.Size = UDim2.new(1, -115, 1, 0)
                if description then
                    label.Size = UDim2.new(1, -115, 0, 18)
                    label.Position = UDim2.fromOffset(0, 0)
                    local sub = makeLabel(row, description, 10, theme.Muted)
                    sub.Position = UDim2.fromOffset(0, 17)
                    sub.Size = UDim2.new(1, -115, 0, 15)
                end
                return label
            end

            function sectionApi:CreateButton(config)
                config = config or {}
                local row = makeRow(34)
                rowLabel(row, config.Name)
                local button = create("TextButton", {
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, 0, 0.5, 0),
                    Size = UDim2.fromOffset(105, 29),
                    BackgroundColor3 = theme.Accent,
                    Text = config.ButtonText or "Run",
                    TextColor3 = Color3.new(1, 1, 1),
                    TextSize = 11,
                    Font = Enum.Font.GothamBold,
                    AutoButtonColor = false,
                }, row)
                corner(button, 6)
                button.MouseButton1Click:Connect(function()
                    if config.Callback then config.Callback() end
                end)
                return button
            end

            function sectionApi:CreateToggle(config)
                config = config or {}
                local value = config.Default == true
                local row = makeRow(34)
                rowLabel(row, config.Name, config.Description)
                local track = create("TextButton", {
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, 0, 0.5, 0),
                    Size = UDim2.fromOffset(39, 21),
                    BackgroundColor3 = value and theme.Accent or theme.Tertiary,
                    Text = "",
                    AutoButtonColor = false,
                }, row)
                corner(track, 20)
                local knob = create("Frame", {
                    AnchorPoint = Vector2.new(0, 0.5),
                    Position = value and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
                    Size = UDim2.fromOffset(15, 15),
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    BorderSizePixel = 0,
                }, track)
                corner(knob, 20)

                local api = {}
                local function setValue(nextValue, fire)
                    value = nextValue == true
                    tween(track, 0.16, {BackgroundColor3 = value and theme.Accent or theme.Tertiary})
                    tween(knob, 0.16, {
                        Position = value and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
                    })
                    if fire and config.Callback then config.Callback(value) end
                end
                track.MouseButton1Click:Connect(function() setValue(not value, true) end)
                function api:Set(nextValue) setValue(nextValue, true) end
                function api:Get() return value end
                return api
            end

            function sectionApi:CreateSlider(config)
                config = config or {}
                local min = config.Min or 0
                local max = config.Max or 100
                local value = math.clamp(config.Default or min, min, max)
                local row = makeRow(53)
                local label = makeLabel(row, config.Name or "Slider", 12, theme.Text, Enum.Font.GothamMedium)
                label.Size = UDim2.new(1, -65, 0, 18)
                local valueLabel = makeLabel(row, tostring(value), 11, theme.Muted)
                valueLabel.TextXAlignment = Enum.TextXAlignment.Right
                valueLabel.Position = UDim2.new(1, -55, 0, 0)
                valueLabel.Size = UDim2.fromOffset(55, 18)
                local bar = create("TextButton", {
                    Position = UDim2.fromOffset(0, 29),
                    Size = UDim2.new(1, 0, 0, 7),
                    BackgroundColor3 = theme.Tertiary,
                    Text = "",
                    AutoButtonColor = false,
                }, row)
                corner(bar, 8)
                local fill = create("Frame", {
                    Size = UDim2.new((value - min) / math.max(max - min, 0.0001), 0, 1, 0),
                    BackgroundColor3 = theme.Accent,
                    BorderSizePixel = 0,
                }, bar)
                corner(fill, 8)

                local api = {}
                local function setValue(nextValue, fire)
                    value = math.clamp(nextValue, min, max)
                    local alpha = (value - min) / math.max(max - min, 0.0001)
                    tween(fill, 0.08, {Size = UDim2.new(alpha, 0, 1, 0)})
                    valueLabel.Text = tostring(value)
                    if fire and config.Callback then config.Callback(value) end
                end
                local function update(input)
                    local alpha = math.clamp((input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
                    setValue(min + (max - min) * alpha, true)
                end
                local sliding = false
                bar.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        sliding = true
                        update(input)
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement
                        or input.UserInputType == Enum.UserInputType.Touch) then update(input) end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then sliding = false end
                end)
                function api:Set(nextValue) setValue(nextValue, true) end
                function api:Get() return value end
                return api
            end

            function sectionApi:CreateTextbox(config)
                config = config or {}
                local row = makeRow(36)
                rowLabel(row, config.Name)
                local box = create("TextBox", {
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, 0, 0.5, 0),
                    Size = UDim2.fromOffset(130, 30),
                    BackgroundColor3 = theme.Tertiary,
                    Text = config.Default or "",
                    PlaceholderText = config.Placeholder or "Enter text...",
                    PlaceholderColor3 = theme.Muted,
                    TextColor3 = theme.Text,
                    TextSize = 11,
                    Font = Enum.Font.Gotham,
                    ClearTextOnFocus = false,
                }, row)
                corner(box, 6)
                padding(box, 8, 8, 0, 0)
                box.FocusLost:Connect(function(enterPressed)
                    if config.Callback then config.Callback(box.Text, enterPressed) end
                end)
                return box
            end

            function sectionApi:CreateDropdown(config)
                config = config or {}
                local values = config.Options or {}
                local selected = config.Default or values[1]
                local row = makeRow(36)
                rowLabel(row, config.Name)
                local button = create("TextButton", {
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, 0, 0.5, 0),
                    Size = UDim2.fromOffset(145, 30),
                    BackgroundColor3 = theme.Tertiary,
                    Text = tostring(selected or "Select") .. "  ▾",
                    TextColor3 = theme.Text,
                    TextSize = 11,
                    Font = Enum.Font.Gotham,
                    AutoButtonColor = false,
                }, row)
                corner(button, 6)

                local menu = create("Frame", {
                    Visible = false,
                    Position = UDim2.new(0, 0, 1, 4),
                    Size = UDim2.new(1, 0, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    BackgroundColor3 = theme.Tertiary,
                    ZIndex = 5,
                }, button)
                corner(menu, 6)
                local menuLayout = create("UIListLayout", {
                    Padding = UDim.new(0, 3),
                }, menu)
                padding(menu, 5, 5, 5, 5)

                local function choose(option)
                    selected = option
                    button.Text = tostring(option) .. "  ▾"
                    menu.Visible = false
                    if config.Callback then config.Callback(option) end
                end
                local function rebuildOptions()
                    for _, child in ipairs(menu:GetChildren()) do
                        if child:IsA("TextButton") then child:Destroy() end
                    end
                    for _, option in ipairs(values) do
                        local optionButton = create("TextButton", {
                            Size = UDim2.new(1, 0, 0, 27),
                            BackgroundColor3 = theme.Secondary,
                            Text = tostring(option),
                            TextColor3 = theme.Text,
                            TextSize = 11,
                            Font = Enum.Font.Gotham,
                            ZIndex = 6,
                        }, menu)
                        corner(optionButton, 4)
                        optionButton.MouseButton1Click:Connect(function() choose(option) end)
                    end
                end
                rebuildOptions()
                menuLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
                    menu.Size = UDim2.new(1, 0, 0, menuLayout.AbsoluteContentSize.Y + 10)
                end)
                button.MouseButton1Click:Connect(function()
                    menu.Visible = not menu.Visible
                end)
                local api = {}
                function api:Set(option)
                    if table.find(values, option) then choose(option) end
                end
                function api:Get() return selected end
                function api:SetOptions(newOptions, defaultOption)
                    values = newOptions or {}
                    selected = defaultOption or values[1]
                    button.Text = tostring(selected or "Select") .. "  ▾"
                    rebuildOptions()
                    menu.Size = UDim2.new(1, 0, 0, menuLayout.AbsoluteContentSize.Y + 10)
                end
                return api
            end

            function sectionApi:CreateColorPicker(config)
                config = config or {}
                local current = typeof(config.Default) == "Color3" and config.Default or theme.Accent
                local row = makeRow(88)
                local label = makeLabel(row, config.Name or "Color", 12, theme.Text, Enum.Font.GothamMedium)
                label.Size = UDim2.new(1, -55, 0, 20)
                local preview = create("Frame", {
                    AnchorPoint = Vector2.new(1, 0),
                    Position = UDim2.new(1, 0, 0, 0),
                    Size = UDim2.fromOffset(42, 20),
                    BackgroundColor3 = current,
                    BorderSizePixel = 0,
                }, row)
                corner(preview, 5)
                local rgbBoxes = {}
                local labels = {"R", "G", "B"}
                local channels = {current.R * 255, current.G * 255, current.B * 255}
                for index, channelName in ipairs(labels) do
                    local x = (index - 1) * 48
                    local channelLabel = makeLabel(row, channelName, 9, theme.Muted)
                    channelLabel.Position = UDim2.fromOffset(x, 27)
                    channelLabel.Size = UDim2.fromOffset(12, 22)
                    local box = create("TextBox", {
                        Position = UDim2.fromOffset(x + 13, 27),
                        Size = UDim2.fromOffset(34, 23),
                        BackgroundColor3 = theme.Tertiary,
                        Text = tostring(math.floor(channels[index] + 0.5)),
                        TextColor3 = theme.Text,
                        PlaceholderText = "0",
                        TextSize = 10,
                        Font = Enum.Font.Gotham,
                        ClearTextOnFocus = false,
                    }, row)
                    corner(box, 5)
                    rgbBoxes[index] = box
                end
                local hexBox = create("TextBox", {
                    Position = UDim2.fromOffset(0, 58),
                    Size = UDim2.fromOffset(145, 24),
                    BackgroundColor3 = theme.Tertiary,
                    Text = "#" .. current:ToHex(),
                    TextColor3 = theme.Text,
                    PlaceholderText = "#RRGGBB",
                    TextSize = 10,
                    Font = Enum.Font.Gotham,
                    ClearTextOnFocus = false,
                }, row)
                corner(hexBox, 5)

                local function updateColor(color, fire)
                    current = color
                    preview.BackgroundColor3 = color
                    local r, g, b = color.R * 255, color.G * 255, color.B * 255
                    local values = {r, g, b}
                    for i, box in ipairs(rgbBoxes) do
                        box.Text = tostring(math.floor(values[i] + 0.5))
                    end
                    hexBox.Text = "#" .. color:ToHex()
                    if fire and config.Callback then config.Callback(color) end
                end
                local function fromRGBBoxes()
                    local values = {}
                    for i, box in ipairs(rgbBoxes) do
                        values[i] = math.clamp(tonumber(box.Text) or 0, 0, 255)
                    end
                    updateColor(Color3.fromRGB(values[1], values[2], values[3]), true)
                end
                for _, box in ipairs(rgbBoxes) do
                    box.FocusLost:Connect(fromRGBBoxes)
                end
                hexBox.FocusLost:Connect(function()
                    local hex = hexBox.Text:gsub("#", "")
                    if #hex == 6 and hex:match("^%x%x%x%x%x%x$") then
                        local r = tonumber(hex:sub(1, 2), 16)
                        local g = tonumber(hex:sub(3, 4), 16)
                        local b = tonumber(hex:sub(5, 6), 16)
                        updateColor(Color3.fromRGB(r, g, b), true)
                    else
                        hexBox.Text = "#" .. current:ToHex()
                    end
                end)
                local api = {}
                function api:Set(color)
                    if typeof(color) == "Color3" then updateColor(color, true) end
                end
                function api:Get() return current end
                return api
            end

            function sectionApi:CreateKeybind(config)
                config = config or {}
                local row = makeRow(34)
                rowLabel(row, config.Name)
                local currentKey = config.Default or Enum.KeyCode.RightShift
                local listening = false
                local button = create("TextButton", {
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, 0, 0.5, 0),
                    Size = UDim2.fromOffset(105, 29),
                    BackgroundColor3 = theme.Tertiary,
                    Text = currentKey.Name,
                    TextColor3 = theme.Text,
                    TextSize = 11,
                    Font = Enum.Font.Gotham,
                    AutoButtonColor = false,
                }, row)
                corner(button, 6)
                button.MouseButton1Click:Connect(function()
                    listening = true
                    button.Text = "Press key..."
                end)
                UserInputService.InputBegan:Connect(function(input, processed)
                    if listening and input.UserInputType == Enum.UserInputType.Keyboard then
                        currentKey = input.KeyCode
                        listening = false
                        button.Text = currentKey.Name
                    elseif not processed and not listening and input.KeyCode == currentKey then
                        if config.Callback then config.Callback(currentKey) end
                    end
                end)
                local api = {}
                function api:Set(keyCode)
                    if typeof(keyCode) == "EnumItem" and keyCode.EnumType == Enum.KeyCode then
                        currentKey = keyCode
                        button.Text = keyCode.Name
                    end
                end
                function api:Get() return currentKey end
                return api
            end

            return sectionApi
        end

        if #window.Tabs == 1 then
            selectTab()
        end

        if not window._settingsCreated and tabName ~= "Settings" then
            window._settingsCreated = true
            local settingsTab = window:CreateTab({Name = "Settings", Icon = "⚙"})
            local appearance = settingsTab:CreateSection("Appearance")

            appearance:CreateDropdown({
                Name = "Accent color",
                Options = {"Violet", "Blue", "Cyan", "Green", "Orange", "Red", "Pink", "White"},
                Default = "Violet",
                Callback = function(choice)
                    local colors = {
                        Violet = Color3.fromRGB(145, 105, 255),
                        Blue = Color3.fromRGB(75, 125, 255),
                        Cyan = Color3.fromRGB(55, 205, 220),
                        Green = Color3.fromRGB(70, 190, 125),
                        Orange = Color3.fromRGB(245, 155, 65),
                        Red = Color3.fromRGB(235, 85, 100),
                        Pink = Color3.fromRGB(235, 105, 175),
                        White = Color3.fromRGB(235, 235, 245),
                    }
                    window:SetAccent(colors[choice])
                end,
            })

            appearance:CreateDropdown({
                Name = "Theme preset",
                Options = {"Midnight", "Ocean", "Forest", "Sunset", "Light"},
                Default = "Midnight",
                Callback = function(choice)
                    local presets = {
                        Midnight = {
                            Background = Color3.fromRGB(12, 13, 19),
                            Secondary = Color3.fromRGB(20, 22, 31),
                            Tertiary = Color3.fromRGB(31, 34, 46),
                            Accent = Color3.fromRGB(145, 105, 255),
                            Text = Color3.fromRGB(242, 243, 250),
                            Muted = Color3.fromRGB(148, 152, 170),
                            Border = Color3.fromRGB(48, 51, 67),
                        },
                        Ocean = {
                            Background = Color3.fromRGB(9, 20, 29),
                            Secondary = Color3.fromRGB(14, 33, 45),
                            Tertiary = Color3.fromRGB(22, 49, 64),
                            Accent = Color3.fromRGB(55, 190, 220),
                            Text = Color3.fromRGB(235, 248, 250),
                            Muted = Color3.fromRGB(139, 174, 185),
                            Border = Color3.fromRGB(35, 76, 91),
                        },
                        Forest = {
                            Background = Color3.fromRGB(13, 21, 17),
                            Secondary = Color3.fromRGB(20, 32, 25),
                            Tertiary = Color3.fromRGB(31, 47, 36),
                            Accent = Color3.fromRGB(90, 190, 125),
                            Text = Color3.fromRGB(239, 247, 240),
                            Muted = Color3.fromRGB(151, 174, 157),
                            Border = Color3.fromRGB(48, 73, 55),
                        },
                        Sunset = {
                            Background = Color3.fromRGB(25, 16, 19),
                            Secondary = Color3.fromRGB(39, 24, 28),
                            Tertiary = Color3.fromRGB(56, 33, 37),
                            Accent = Color3.fromRGB(245, 130, 95),
                            Text = Color3.fromRGB(255, 242, 236),
                            Muted = Color3.fromRGB(188, 151, 143),
                            Border = Color3.fromRGB(83, 52, 53),
                        },
                        Light = {
                            Background = Color3.fromRGB(235, 237, 243),
                            Secondary = Color3.fromRGB(249, 250, 253),
                            Tertiary = Color3.fromRGB(222, 225, 234),
                            Accent = Color3.fromRGB(105, 85, 220),
                            Text = Color3.fromRGB(29, 31, 42),
                            Muted = Color3.fromRGB(100, 104, 120),
                            Border = Color3.fromRGB(200, 204, 216),
                        },
                    }
                    if presets[choice] then window:SetTheme(presets[choice]) end
                end,
            })

            appearance:CreateColorPicker({
                Name = "Custom RGB / Hex accent",
                Default = theme.Accent,
                Callback = function(color)
                    window:SetAccent(color)
                end,
            })

            appearance:CreateTextbox({
                Name = "Background image",
                Placeholder = "Image asset ID (optional)",
                Callback = function(value)
                    window:SetBackgroundImage(value)
                end,
            })

            appearance:CreateSlider({
                Name = "Image opacity",
                Min = 0,
                Max = 100,
                Default = math.floor((1 - window.BackgroundImageOpacity) * 100),
                Callback = function(value)
                    window:SetBackgroundImageOpacity(1 - value / 100)
                end,
            })

            appearance:CreateSlider({
                Name = "UI opacity",
                Min = 0,
                Max = 80,
                Default = math.floor(window.Opacity * 100),
                Callback = function(value)
                    window:SetOpacity(value / 100)
                end,
            })

            appearance:CreateSlider({
                Name = "UI size",
                Min = 60,
                Max = 120,
                Default = 100,
                Callback = function(value)
                    window:SetSize(value)
                end,
            })

            local themeSection = settingsTab:CreateSection("Saved themes")
            local themeNameBox = themeSection:CreateTextbox({
                Name = "Theme name",
                Placeholder = "Name your theme",
            })
            local renameFromBox = themeSection:CreateTextbox({
                Name = "Rename from",
                Placeholder = "Existing theme name",
            })
            local renameToBox = themeSection:CreateTextbox({
                Name = "Rename to",
                Placeholder = "New theme name",
            })
            local savedThemeDropdown
            local function refreshSavedThemeDropdown()
                local names = window:GetSavedThemes()
                if #names == 0 then names = {"No saved themes yet"} end
                if savedThemeDropdown then
                    savedThemeDropdown:SetOptions(names, names[1])
                end
            end
            savedThemeDropdown = themeSection:CreateDropdown({
                Name = "Saved themes",
                Options = {"No saved themes yet"},
                Default = "No saved themes yet",
                Callback = function(name)
                    if name == "No saved themes yet" then return end
                    local ok, message = window:LoadTheme(name)
                    window:Notify({Type = ok and "success" or "error", Title = ok and "Theme loaded" or "Load failed", Content = ok and ("Loaded '" .. name .. "'.") or message})
                end,
            })
            themeSection:CreateButton({
                Name = "Save current theme",
                ButtonText = "Save",
                Callback = function()
                    local ok, message = window:SaveTheme(themeNameBox.Text)
                    refreshSavedThemeDropdown()
                    window:Notify({Type = ok and "success" or "warning", Title = ok and "Theme saved" or "Theme not saved", Content = ok and ("Saved '" .. themeNameBox.Text .. "'.") or message})
                end,
            })
            themeSection:CreateButton({
                Name = "Delete theme",
                ButtonText = "Delete",
                Callback = function()
                    local ok = window:DeleteTheme(themeNameBox.Text)
                    refreshSavedThemeDropdown()
                    window:Notify({Type = ok and "success" or "warning", Content = ok and "Theme deleted." or "Theme not found."})
                end,
            })
            themeSection:CreateButton({
                Name = "Rename theme",
                ButtonText = "Rename",
                Callback = function()
                    local ok, message = window:RenameTheme(renameFromBox.Text, renameToBox.Text)
                    refreshSavedThemeDropdown()
                    window:Notify({Type = ok and "success" or "warning", Content = ok and "Theme renamed." or message})
                end,
            })
            applyResponsiveLayout()
        end
        return tab
    end

    function window:Destroy()
        if not self.Destroyed then
            self.Destroyed = true
            screenGui:Destroy()
        end
    end

    if options.OpenOnCreate == false then
        screenGui.Enabled = false
    else

        local splash = create("Frame", {
            Name = "LoadingSplash",
            Size = UDim2.fromScale(1, 1),
            BackgroundColor3 = theme.Background,
            BackgroundTransparency = 0.08,
            BorderSizePixel = 0,
            ZIndex = 100,
        }, screenGui)
        local wordmark = create("TextLabel", {
            Name = "Wordmark",
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(260, 58),
            BackgroundTransparency = 1,
            Text = options.Name or "fork",
            TextColor3 = theme.Text,
            TextSize = 31,
            Font = Enum.Font.GothamBold,
            ZIndex = 101,
        }, splash)
        local highlight = create("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(0, 3),
            BackgroundColor3 = theme.Accent,
            BorderSizePixel = 0,
            ZIndex = 102,
        }, splash)
        local expandedSize = main.Size
        main.Size = UDim2.fromOffset(0, 3)
        task.spawn(function()
            task.wait(0.55)
            tween(wordmark, 0.28, {TextTransparency = 1, TextSize = 24})
            tween(highlight, 0.28, {Size = UDim2.fromOffset(170, 3)})
            task.wait(0.3)
            tween(highlight, 0.28, {Size = UDim2.fromOffset(260, 3)})
            task.wait(0.3)
            tween(splash, 0.3, {BackgroundTransparency = 1})
            tween(main, 0.48, {Size = expandedSize})
            task.wait(0.5)
            if splash.Parent then splash:Destroy() end
        end)
    end

    return window
end

return Library
