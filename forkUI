                local function updateColor(color, fire)
                    current = color
                    preview.BackgroundColor3 = color
                    local r, g, b = color.R * 255, color.G * 255, color.B * 255
                    local values = {r, g, b}
                    for i, box in ipairs(rgbBoxes) do
                        box.Text = tostring(math.floor(values[i] + 0.5))
                    end
                    hexBox.Text = "#" .. color:ToHex()
                    if fire and config.Callback then config.Callback(color) end
