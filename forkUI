                end,
            })
            configSection:CreateButton({
                Name = "Refresh list",
                ButtonText = "Refresh",
                Callback = refreshConfigs,
            })
            configSection:CreateDivider("Autoload")
            autoloadLabel = configSection:CreateLabel("Autoload: none")
            configSection:CreateButton({
                Name = "Set selected as autoload",
                ButtonText = "Set",
                Callback = function()
                    if not selectedConfig then return report(false, "Select a config first") end
                    local ok = window:SetAutoload(selectedConfig)
                    refreshConfigs()
                    report(ok, "Could not save autoload", "Autoload set to '" .. selectedConfig .. "'.")
                end,
            })
            configSection:CreateButton({
                Name = "Clear autoload",
                ButtonText = "Clear",
                Callback = function()
                    local ok = window:SetAutoload(nil)
                    refreshConfigs()
                    report(ok, "Could not clear autoload", "Autoload cleared.")
                end,
            })
            refreshConfigs()
            window._noFlags = false
        end
        applyResponsiveLayout()
        return tab
    end

    function window:Destroy()
        if not self.Destroyed then
            self.Destroyed = true
            screenGui:Destroy()
        end
    end

    if options.AutoLoad ~= false then
        task.delay(0.6, function()
            if not window.Destroyed and not window._autoloaded then
                window:LoadAutoload()
            end
        end)
    end

    if options.OpenOnCreate == false then
        screenGui.Enabled = false
    else

        local splash = create("Frame", {
            Name = "LoadingSplash",
            Size = UDim2.fromScale(1, 1),
            BackgroundColor3 = theme.Background,
            BackgroundTransparency = 0.08,
            BorderSizePixel = 0,
            ZIndex = 100,
        }, screenGui)
        local wordmark = create("TextLabel", {
            Name = "Wordmark",
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(260, 58),
            BackgroundTransparency = 1,
            Text = options.Name or "fork",
            TextColor3 = theme.Text,
            TextSize = 31,
            Font = Enum.Font.GothamBold,
            ZIndex = 101,
        }, splash)
        local highlight = create("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(0, 3),
            BackgroundColor3 = theme.Accent,
            BorderSizePixel = 0,
            ZIndex = 102,
        }, splash)
        main.Size = UDim2.fromOffset(0, 3)
        main.GroupTransparency = 1
        task.spawn(function()
            task.wait(0.55)
            tween(wordmark, 0.28, {TextTransparency = 1, TextSize = 24})
            tween(highlight, 0.28, {Size = UDim2.fromOffset(170, 3)})
            task.wait(0.3)
            tween(highlight, 0.28, {Size = UDim2.fromOffset(260, 3)})
            task.wait(0.3)
            tween(splash, 0.3, {BackgroundTransparency = 1})
            tween(main, 0.4, {GroupTransparency = 0}, Enum.EasingStyle.Quad)
            tween(main, 0.55, {Size = computeMainSize()})
            task.wait(0.56)
            introPlaying = false
            if not window.Destroyed then
                main.Size = computeMainSize()
            end
            if splash.Parent then splash:Destroy() end
        end)
    end

    return window
end

return Library
